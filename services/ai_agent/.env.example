# ==========================================
# AgriResolve Environment Configuration
# ==========================================

# --- NVIDIA / Meterless AI Model Power Layer ---
# NVIDIA API key or Meterless authentication token
NVIDIA_API_KEY=your_nvidia_or_meterless_api_key_here
# NVIDIA NIM or Meterless base endpoint URL (e.g. https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model identifier (e.g. nvidia/nemotron-4-340b-instruct or meta/llama-3.1-70b-instruct)
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
# Timeout in seconds for AI inference calls
NVIDIA_TIMEOUT_SECONDS=60

# --- Zetaris Data Layer Adapter ---
# Zetaris network endpoint / base URL provided by Data Lead teammate
ZETARIS_ENDPOINT=https://zetaris.example.com/api/v1
# API Key, OAuth token, or Basic Auth token for Zetaris data lakehouse
ZETARIS_API_KEY=your_zetaris_api_key_here
# Default catalog / database / schema in Zetaris
ZETARIS_CATALOG=agri_lakehouse
ZETARIS_SCHEMA=disputes_gold

# --- Agent Investigation Policy Limits ---
# Maximum permitted iterations in the investigation loop to prevent endless cycles
MAX_INVESTIGATION_STEPS=6
# Maximum allowed tool calls per step
MAX_TOOL_CALLS_PER_STEP=4
